✅ 3. Настройка Zabbix (мониторинг)
Подключитесь к Zabbix серверу:

bash
ssh ubuntu@51.250.74.246
Выполните установку:

bash
# Установка репозитория
wget https://repo.zabbix.com/zabbix/6.0/ubuntu/pool/main/z/zabbix-release/zabbix-release_6.0-4+ubuntu22.04_all.deb
sudo dpkg -i zabbix-release_6.0-4+ubuntu22.04_all.deb
sudo apt update

# Установка Zabbix Server, Frontend, Nginx
sudo apt install zabbix-server-pgsql zabbix-frontend-php php8.1-pgsql zabbix-nginx-conf zabbix-sql-scripts zabbix-agent -y

# Установка PostgreSQL
sudo apt install postgresql -y
sudo systemctl start postgresql
sudo systemctl enable postgresql

# Создание БД
sudo -u postgres psql -c "CREATE USER zabbix WITH PASSWORD 'zabbix_password';"
sudo -u postgres psql -c "CREATE DATABASE zabbix OWNER zabbix;"
sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE zabbix TO zabbix;"
sudo -u zabbix zcat /usr/share/zabbix-sql-scripts/postgresql/server.sql.gz | sudo -u zabbix psql zabbix

# Настройка Zabbix Server
sudo sed -i 's/# DBPassword=/DBPassword=zabbix_password/' /etc/zabbix/zabbix_server.conf

# Настройка Nginx
sudo sed -i 's/# listen 80;/listen 80;/' /etc/zabbix/nginx.conf
sudo sed -i 's/# server_name example.com;/server_name 51.250.74.246;/' /etc/zabbix/nginx.conf

# Запуск
sudo systemctl restart zabbix-server zabbix-agent nginx php8.1-fpm
sudo systemctl enable zabbix-server zabbix-agent nginx php8.1-fpm
Откройте в браузере: http://51.250.74.246

